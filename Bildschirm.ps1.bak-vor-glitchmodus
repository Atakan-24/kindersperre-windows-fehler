        $lw = $size * 0.98; $lh = $lw * $script:logoImg.Height / $script:logoImg.Width
        $g.InterpolationMode = [Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
        $g.DrawImage($script:logoImg, [single]($cx - $lw / 2), [single]$top, [single]$lw, [single]$lh)
    } else {
        $q = $size * 0.46; $gap = $size * 0.04
        foreach ($p in @(@(0, 0), @(1, 0), @(0, 1), @(1, 1))) {
