function Stop-UserApps {
    if (-not $script:killApps) { return }
    try {
        $kc = Get-Content (Join-Path $Dir 'config.json') -Raw | ConvertFrom-Json
        if ($kc.KillApps -eq $false) { return }
        if ($kc.KillPauseUntil -and (Get-Date) -lt [datetime]::ParseExact([string]$kc.KillPauseUntil, 'yyyy-MM-ddTHH:mm:ss', [Globalization.CultureInfo]::InvariantCulture)) { return }   # Pause: nichts beenden
    } catch { }
    $sid = [Diagnostics.Process]::GetCurrentProcess().SessionId
    # Laeuft irgendwo auf dem PC (jede Sitzung) gerade eine Installation? Dann wird in dieser Runde NICHTS beendet;
    # der naechste Durchgang (30 s) prueft erneut. Nur Prozesse juenger als 4 Stunden zaehlen (kein dauerhaftes Aussetzen).
    try {
        $inst = @(Get-Process -ErrorAction SilentlyContinue | Where-Object {
            $_.ProcessName -match '(?i)^(msiexec|winget|choco)$|setup|install' -and $_.ProcessName -notmatch '(?i)TrustedInstaller|TiWorker|InstallAgent' -and
            $(try { ((Get-Date) - $_.StartTime).TotalHours -lt 4 } catch { $true }) })
        if ($inst.Count) {
            if (-not $script:killHeld) {
                $script:killHeld = $true
                $m = 'Programme werden nicht beendet: Installation laeuft ({0})' -f (($inst | Select-Object -ExpandProperty ProcessName -Unique) -join ', ')
                OLog $m
                try { ('{0}  {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $m) | Out-File (Join-Path $Dir 'log.txt') -Append -Encoding ascii } catch { }
            }
            return
        }
        $script:killHeld = $false
    } catch { }
    $names = @()
    foreach ($p in @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.SessionId -eq $sid -and $_.Id -ne $PID -and [int64]$_.MainWindowHandle -ne 0 })) {
        if ($script:killOnly.Count) { if ($script:killOnly -notcontains $p.ProcessName) { continue } }
        elseif ($script:killKeep -contains $p.ProcessName) { continue }
        if ($p.ProcessName -match '(?i)setup|install|msiexec|update|TrustedInstaller|winget') { continue }   # Installationen nie abbrechen
        try { $p.Kill(); $names += $p.ProcessName } catch { }
    }
    if ($names.Count) {
        $m = 'Programme beendet (Sitzung {0}): {1}' -f $sid, (($names | Select-Object -Unique) -join ', ')
        OLog $m
        try { ('{0}  {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $m) | Out-File (Join-Path $Dir 'log.txt') -Append -Encoding ascii } catch { }
    }
}

