# Sperrbildschirm der Kindersperre: sieht aus wie ein Systemabsturz im Terminal (schwarz, monospace, rot/grau).
# Wird von Sperre.ps1 als SYSTEM in der Benutzersitzung gestartet. Schliesst sich nur, wenn das Limit nicht mehr gilt
# (neuer Tag / Bonus durch Betreuer-PIN). Im Testmodus (-TestSeconds) schliesst er sich nach der angegebenen Zeit.
param([int]$TestSeconds = 0, [string]$Shot = '')

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$Dir  = 'C:\ProgramData\Kindersperre'
$cfg  = Get-Content (Join-Path $Dir 'config.json') -Raw | ConvertFrom-Json
$test = $TestSeconds -gt 0
$script:allowClose = $false
$script:wasMuted   = $false
$script:muteOk     = $false
$script:lastLocked = $true
$script:fails      = 0
$script:blockedUntil = [datetime]::MinValue
$script:start      = Get-Date
$script:shotDone   = $false
$script:tick       = 0
$script:errId      = ('{0:X4}-{1:X4}-{2:X4}' -f (Get-Random -Maximum 65535), (Get-Random -Maximum 65535), (Get-Random -Maximum 65535))

function OLog($m) { if ($test) { ('{0}  {1}' -f (Get-Date -Format 'HH:mm:ss'), $m) | Out-File (Join-Path $Dir 'overlay.log') -Append -Encoding ascii } }

