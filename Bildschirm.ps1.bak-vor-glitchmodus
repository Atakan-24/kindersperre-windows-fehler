    }
}

# Ladekreis: fuenf Punkte, oben eng beieinander, unten auseinandergezogen (wie im Prototyp)
function Draw-Spinner($g, [double]$sx, [double]$sy, [double]$sr, [double]$sc) {
    $rad = 4.4 * $sc
    for ($i = 0; $i -lt 5; $i++) {
        $x = ($script:spin * 0.42 - $i * 0.075) % 1.0; if ($x -lt 0) { $x += 1.0 }
        $e = (1.0 - [Math]::Cos([Math]::PI * $x)) / 2.0
        $a = $e * 2.0 * [Math]::PI - [Math]::PI / 2.0
        $g.FillEllipse([Drawing.Brushes]::White, [single]($sx + [Math]::Cos($a) * $sr - $rad), [single]($sy + [Math]::Sin($a) * $sr - $rad), [single]($rad * 2), [single]($rad * 2))
    }
}

function Paint-Windows($g, $cv) {
    $w = $cv.ClientSize.Width; $h = $cv.ClientSize.Height
    $sc = $h / 1080.0
    $g.SmoothingMode = [Drawing.Drawing2D.SmoothingMode]::AntiAlias
    $g.TextRenderingHint = [Drawing.Text.TextRenderingHint]::ClearTypeGridFit
    $ph = $script:phase
    if ($ph -eq 'glitch1' -or $ph -eq 'glitch2') {
        if ($cv.Tag.Frame) { $g.DrawImageUnscaled($cv.Tag.Frame, 0, 0) } else { $g.Clear([Drawing.Color]::Black) }
        return
    }
    if ($ph -eq 'bsod') { Draw-Bsod $g $w $h $sc; return }
    $g.Clear([Drawing.Color]::Black)
    if ($ph -eq 'black' -or $ph -eq 'outro-black' -or $ph -eq '') { return }
    $cx = $w / 2.0; $cy = $h / 2.0
    if ($ph -eq 'logo' -or $ph -eq 'outro-logo') {
        Draw-Logo $g $cx ($cy - 210 * $sc) (150 * $sc)
        Draw-Spinner $g $cx ($cy + 150 * $sc) (24 * $sc) $sc
    } else {
        $fmt = New-Object Drawing.StringFormat
        $fmt.Alignment = [Drawing.StringAlignment]::Center
        $txt = if ($ph -eq 'repair1') { $script:txtRepair1 } else { $script:txtRepair2 }
        Draw-Spinner $g $cx ($cy - 40 * $sc) (24 * $sc) $sc
        $g.DrawString($txt, (Get-Fnt (38 * $sc) 'Segoe UI Light'), [Drawing.Brushes]::White, (New-Object Drawing.RectangleF(0, [single]($cy + 20 * $sc), [single]$w, [single](80 * $sc))), $fmt)
        $fmt.Dispose()
    }
    if ($script:ticker -and $script:tickerText -and $ph -notlike 'outro*') {
        $g.DrawString($script:tickerText, (Get-Fnt (13 * $sc) 'Consolas'), $script:tickBrush, [single](24 * $sc), [single]($h - 30 * $sc))
    }
}

# Unauffaellige Zeile unten links: echte Treiberdateien und laufende Programme dieses PCs
function Update-Ticker {
    if ($null -eq $script:drvList) {
        try { $script:drvList = @(Get-ChildItem 'C:\Windows\System32\drivers' -Filter *.sys -Name -ErrorAction Stop) } catch { $script:drvList = @() }
        if ($script:drvList.Count) { $script:drvI = Get-Random -Maximum $script:drvList.Count }
    }
    if (((Get-Date) - $script:procAt).TotalSeconds -gt 30) {
        $script:procAt = Get-Date
        try { $script:procList = @(Get-Process | Where-Object { $_.SessionId -ne 0 } | Select-Object -ExpandProperty ProcessName -Unique) } catch { }
    }
    $script:tickN++
    if ($script:tickN % 3 -eq 0 -and $script:procList.Count) {
        $script:tickerText = 'Aktiver Prozess  ' + $script:procList[(Get-Random -Maximum $script:procList.Count)] + '.exe'
    } elseif ($script:drvList.Count) {
        $script:drvI = ($script:drvI + 1) % $script:drvList.Count
        $script:tickerText = 'Prüfe Datei  C:\Windows\System32\drivers\' + $script:drvList[$script:drvI]
    }
}

