            $e.SuppressKeyPress = $true
            $pin = $script:pinBox.Text
            $script:pinBox.Text = ''
            if ((Get-Date) -lt $script:blockedUntil) { return }
            if (Test-Pin $pin) {
                $bf = Join-Path $Dir 'bonus.txt'
                $new = (Get-Bonus) + [double]$cfg.BonusMin
                if ($test) { OLog 'Test: PIN korrekt, Bonus nicht gebucht' } else { ('{0};{1}' -f (Get-DayKey), [int]$new) | Out-File $bf -Encoding ascii }
                Close-All
            } else {
                $script:fails++
                OLog 'PIN falsch'
                if ($script:fails -ge 5) {
                    $script:blockedUntil = (Get-Date).AddMinutes(5); $script:fails = 0
                    $script:info.Text = 'Zu viele Versuche. Eingabe 5 Minuten gesperrt.'
                } else { $script:info.Text = 'Ungültiger Code.' }
            }
        })

        $cv.Controls.Add($t); $cv.Controls.Add($box); $cv.Controls.Add($msg)
        $script:pinCtrls = @($t, $box, $msg)
        $script:pinBox = $box
        $script:info = $msg
        $script:primary = $f
    }
    $script:forms += $f
}
if (-not $script:primary) { $script:primary = $script:forms[0] }

# ---- PIN-Feld ist unsichtbar; Leertaste + F12 + Alt blendet es fuer 30 s ein (Panel bleibt, Layout unveraendert) ----
$script:pinShown = $false
$script:pinShownAt = [datetime]::MinValue
function Show-Pin([bool]$on) {
    if (-not $script:pinBox) { return }
    foreach ($c in $script:pinCtrls) { $c.Visible = $on }
    $script:pinShown = $on
    OLog "PIN-Feld sichtbar = $on"
    if ($script:keysOk) { [KsKeys]::AllowShift = $on }
    if ($on) { $script:pinShownAt = Get-Date; $script:pinBox.Focus() | Out-Null }
    else { $script:pinBox.Text = ''; $script:info.Text = '' }
}
if ($script:keysOk) {
    try {
        if ([KsKeys]::Install()) {
            [KsKeys]::Active = ($script:keyLock -and (-not $test -or (Test-Path (Join-Path $Dir 'keytest.flag'))))
            OLog "Tastensperre: Hook installiert, aktiv = $([KsKeys]::Active)"
        } else { $script:keysOk = $false; OLog 'Tastensperre: Hook fehlgeschlagen' }
    } catch { $script:keysOk = $false; OLog "Tastensperre-Fehler: $_" }
}
# Ohne Tastatur-Hook kaeme man nie an das PIN-Feld: dann bleibt es sichtbar (Betreuer nicht aussperren)
if ($script:keysOk) { Show-Pin $false } else { Show-Pin $true }

# ---- Ablaufsteuerung des Windows-Looks (eigener schneller Timer, 50 ms) ----
function Update-Frames([int]$level) {
    foreach ($c in $script:canvases) {
        $t = $c.Tag
        if ($t.Desk) {
            $old = $t.Frame
            $t.Frame = [KsFx]::MakeGlitch($t.Desk, $t.W, $t.H, (100 * $level + $script:frameN), $level)
            if ($old) { $old.Dispose() }
        }
    }
}

function Save-PhaseShot([string]$name) {
    $script:phaseShots[$name] = $true
    try {
        $b = $primaryScreen.Bounds
        $bmp = New-Object Drawing.Bitmap($b.Width, $b.Height)
        $g = [Drawing.Graphics]::FromImage($bmp)
        $g.CopyFromScreen($b.Location, [Drawing.Point]::Empty, $b.Size)
        $bmp.Save(([IO.Path]::ChangeExtension($Shot, $null).TrimEnd('.') + '-' + $name + '.png'), [Drawing.Imaging.ImageFormat]::Png)
        $g.Dispose(); $bmp.Dispose()
        OLog "Screenshot Phase $name"
    } catch { OLog "Screenshot-Fehler: $_" }
}
function Step-Sequence {
    $el = ((Get-Date) - $script:seqT0).TotalSeconds * $script:speed + $script:seqOffset
    $acc = 0.0; $ph = $script:tl[$script:tl.Count - 1]; $pt = 0.0
    foreach ($p in $script:tl) {
        if ($p.D -eq 0 -or $el -lt ($acc + $p.D)) { $ph = $p; $pt = $el - $acc; break }
        $acc += $p.D
    }
    if ($script:outroTest -and -not $script:outroT0 -and $el -ge $script:outroAt) { $script:outroT0 = Get-Date; OLog 'Outro (Test) gestartet' }
    if ($script:outroT0) {
        # "Neustart" beim regulaeren Ende: 2 s Schwarz, 6 s Windows-Logo, dann Bildschirm weg
        $ot = ((Get-Date) - $script:outroT0).TotalSeconds
        $script:spin = $ot
        $nm = if ($ot -lt 2.0) { 'outro-black' } elseif ($ot -lt 8.0) { 'outro-logo' } else { '' }
        if (-not $nm) { OLog 'Outro fertig, schliesse'; Close-All; return }
        if ($nm -ne $script:phase) { $script:phase = $nm; OLog "Phase: $nm"; foreach ($c in $script:canvases) { $c.Invalidate() } }
        elseif ($nm -eq 'outro-logo') { foreach ($c in $script:canvases) { $c.Invalidate() } }
        if ($test -and $Shot -and -not $script:phaseShots.ContainsKey($nm) -and $ot -ge $(if ($nm -eq 'outro-black') { 1.0 } else { 5.0 })) { Save-PhaseShot $nm }
        return
    }
    $redraw = $false
    if ($ph.N -ne $script:phase) { $script:phase = $ph.N; $redraw = $true; OLog "Phase: $($ph.N)" }
    if (-not $script:killDone -and ($ph.N -eq 'black' -or $ph.N -eq 'logo')) { $script:killDone = $true; Stop-UserApps }
    $script:spin = $el
    switch ($ph.N) {
        'glitch1' { $script:frameN++; Update-Frames 1; $redraw = $true }
        'glitch2' { $script:frameN++; Update-Frames 2; $redraw = $true }
        'bsod'    { $p2 = [Math]::Min(100, [int]([Math]::Floor($pt / 0.5) * 5)); if ($p2 -ne $script:pct) { $script:pct = $p2; $redraw = $true } }
        'black'   { }
        default   { $redraw = $true }
    }
    if ($script:ticker -and ($ph.N -eq 'logo' -or $ph.N -eq 'repair1' -or $ph.N -eq 'repair2') -and (Get-Date) -ge $script:nextTick) {
        $script:nextTick = (Get-Date).AddMilliseconds(700)
        Update-Ticker
    }
    if ($redraw) { foreach ($c in $script:canvases) { $c.Invalidate() } }
    # Testmodus mit -Shot: je Phase ein Bild (Name = <Shot>-<Phase>.png)
    if ($test -and $Shot -and -not $script:phaseShots.ContainsKey($ph.N)) {
        $need = [Math]::Min(1.5, $(if ($ph.D -gt 0) { 0.6 * $ph.D } else { 1.5 }))
        if ($pt -ge $need) {
            $script:phaseShots[$ph.N] = $true
            try {
                $b = $primaryScreen.Bounds
                $bmp = New-Object Drawing.Bitmap($b.Width, $b.Height)
                $g = [Drawing.Graphics]::FromImage($bmp)
                $g.CopyFromScreen($b.Location, [Drawing.Point]::Empty, $b.Size)
                $bmp.Save(([IO.Path]::ChangeExtension($Shot, $null).TrimEnd('.') + '-' + $ph.N + '.png'), [Drawing.Imaging.ImageFormat]::Png)
                $g.Dispose(); $bmp.Dispose()
                OLog "Screenshot Phase $($ph.N)"
            } catch { OLog "Screenshot-Fehler: $_" }
        }
    }
}

$script:anim = New-Object Windows.Forms.Timer
$script:anim.Interval = 50
$script:anim.Add_Tick({ try { Step-Sequence } catch { OLog "Ablauffehler: $_" } })

$script:timer = New-Object Windows.Forms.Timer
$script:timer.Interval = 500
$script:timer.Add_Tick({
    $script:tick++
    foreach ($f in $script:forms) { $f.TopMost = $true }
    if ($script:keysOk) {
        if ([KsKeys]::PinRequested) { [KsKeys]::PinRequested = $false; Show-Pin $true }
        elseif ($script:pinShown -and ((Get-Date) - $script:pinShownAt).TotalSeconds -gt 30) { Show-Pin $false }
    }
    try {
        $script:lines = Get-LockLines
        foreach ($c in $script:canvases) { $c.Invalidate() }
    } catch { OLog "Textfehler: $_" }
    if (-not $script:primary.ContainsFocus) { $script:primary.Activate(); if ($script:pinBox) { $script:pinBox.Focus() | Out-Null } }
    if ($script:tick % 4 -eq 0) {
        Set-Muted
        if ($script:tick % 60 -eq 0 -and $script:killDone) { Stop-UserApps }
        if (-not $test -and -not (Test-StillLocked)) {
            if ($script:look -eq 'windows' -and $script:outroOn -and $script:anim.Enabled) {
                if (-not $script:outroT0) { $script:outroT0 = Get-Date; OLog 'Sperre beendet: Outro' }
            } else { Close-All; return }
        }
    }
    if ($test) {
        $el = ((Get-Date) - $script:start).TotalSeconds
        if ($Shot -and -not $script:shotDone -and $el -ge 3) {
            $script:shotDone = $true
            try {
                $b = $primaryScreen.Bounds
                $bmp = New-Object Drawing.Bitmap($b.Width, $b.Height)
                $g = [Drawing.Graphics]::FromImage($bmp)
                $g.CopyFromScreen($b.Location, [Drawing.Point]::Empty, $b.Size)
                $bmp.Save($Shot, [Drawing.Imaging.ImageFormat]::Png)
                OLog "Screenshot gespeichert; Ton jetzt stumm = $(if ($script:muteOk) { [KsAudio]::GetMute() } else { 'n/a' })"
            } catch { OLog "Screenshot-Fehler: $_" }
        }
        if ($el -ge $TestSeconds) { OLog 'Testzeit vorbei, schliesse'; Close-All }
    }
})

foreach ($f in $script:forms) { $f.Show() }
$script:primary.Activate()
if ($script:pinBox) { $script:pinBox.Focus() | Out-Null }
Set-Muted
$script:timer.Start()
if ($script:look -eq 'windows') {
    try { [Windows.Forms.Cursor]::Hide() } catch { }
    $script:seqT0 = Get-Date
    $script:anim.Start()
}
[Windows.Forms.Application]::Run($script:primary)
