# QR-Code-Attrappe (wie im Prototyp: zufaelliges Muster mit drei Eckmarken), einmal je Groesse gezeichnet
function Get-Qr([double]$cell) {
    $k = [int]($cell * 10)
    if (-not $script:qr.ContainsKey($k)) {
        $n = 25; $c = [single]$cell
        $size = [int][Math]::Ceiling(($n + 2) * $c)
        $bmp = New-Object Drawing.Bitmap($size, $size)
        $g = [Drawing.Graphics]::FromImage($bmp)
        $g.Clear([Drawing.Color]::White)
        $rnd = New-Object Random(7)
        for ($yy = 0; $yy -lt $n; $yy++) {
            for ($xx = 0; $xx -lt $n; $xx++) {
                $fin = ($xx -lt 8 -and $yy -lt 8) -or ($xx -gt $n - 9 -and $yy -lt 8) -or ($xx -lt 8 -and $yy -gt $n - 9)
                if (-not $fin -and $rnd.NextDouble() -lt 0.5) { $g.FillRectangle([Drawing.Brushes]::Black, [single]($c + $xx * $c), [single]($c + $yy * $c), $c, $c) }
            }
        }
        foreach ($p in @(@(0, 0), @(($n - 7), 0), @(0, ($n - 7)))) {
            $fx = [single]($c + $p[0] * $c); $fy = [single]($c + $p[1] * $c)
            $g.FillRectangle([Drawing.Brushes]::Black, $fx, $fy, [single](7 * $c), [single](7 * $c))
            $g.FillRectangle([Drawing.Brushes]::White, [single]($fx + $c), [single]($fy + $c), [single](5 * $c), [single](5 * $c))
            $g.FillRectangle([Drawing.Brushes]::Black, [single]($fx + 2 * $c), [single]($fy + 2 * $c), [single](3 * $c), [single](3 * $c))
        }
        $g.Dispose()
        $script:qr[$k] = $bmp
    }
    return $script:qr[$k]
}

function Draw-Bsod($g, $w, $h, $sc) {
    $g.Clear([Drawing.Color]::FromArgb(0, 120, 215))
    $white = [Drawing.Brushes]::White
    $x0 = $w * 0.128
    $g.DrawString(':(', (Get-Fnt (200 * $sc)), $white, [single]($x0 - 14 * $sc), [single](60 * $sc))
    $t1 = 'Auf dem Gerät ist ein Problem aufgetreten. Er muss neu gestartet werden. Es werden einige Fehlerinformationen gesammelt, und dann wird ein Neustart ausgeführt.'
    $g.DrawString($t1, (Get-Fnt (34 * $sc)), $white, (New-Object Drawing.RectangleF([single]$x0, [single](400 * $sc), [single]($w * 0.58), [single](190 * $sc))))
    $g.DrawString(('{0}% abgeschlossen' -f $script:pct), (Get-Fnt (34 * $sc)), $white, [single]$x0, [single](585 * $sc))
    $g.DrawImageUnscaled((Get-Qr (5 * $sc)), [int]($x0 - 5 * $sc), [int](685 * $sc))
    $lines = @('Weitere Informationen zu diesem Problem und mögliche Lösungen finden Sie unter', 'https://www.windows.com/stopcode', '',
               'Halten Sie folgende Infos bereit, wenn Sie den Support anrufen:', 'Stillstandcode: VIDEO_TDR_FAILURE', 'Fehlerursache: nvlddmkm.sys')
    $fs = Get-Fnt (17 * $sc)
    for ($i = 0; $i -lt $lines.Count; $i++) { $g.DrawString($lines[$i], $fs, $white, [single]($x0 + 150 * $sc), [single](690 * $sc + $i * 24 * $sc)) }
}

function Draw-Logo($g, [double]$cx, [double]$top, [double]$size) {
    if (-not $script:logoTried) {
        $script:logoTried = $true
        try { $script:logoImg = New-Object Drawing.Bitmap((Join-Path $Dir 'assets\winlogo.png')) } catch { OLog "Logo nicht geladen: $_" }
    }
