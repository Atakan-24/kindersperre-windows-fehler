                if (mode == 1) { int t = R; R = B; B = t; }
                else if (mode == 2) { R = 255 - R; G = 255 - G; B = 255 - B; }
                else if (mode == 3) { G = G / 3; R = C255(R * 3 / 2); B = C255(B * 3 / 2); }
                dp[yy * W + xx] = Argb(R, G, B);
            }
    }

    static void VLine(int[] dp, int W, int H, int x, int y, int h, int w, Random rnd)
    {
        int col = rnd.Next(2) == 0 ? Argb(255, 0, 255) : Argb(0, 255, 70);
        for (int yy = y; yy < Math.Min(H, y + h); yy++)
            for (int xx = x; xx < Math.Min(W, x + w); xx++) dp[yy * W + xx] = col;
    }

    static void Tint(int[] dp, int W, int H, int y0, int h, int mode)
    {
        for (int yy = Math.Max(0, y0); yy < Math.Min(H, y0 + h); yy++)
            for (int x = 0; x < W; x++)
            {
                int p = dp[yy * W + x]; int R = (p >> 16) & 255, G = (p >> 8) & 255, B = p & 255;
                if (mode == 0) { R = C255(R * 7 / 5); G = G / 2; B = C255(B * 13 / 10); }
                else if (mode == 1) { R = R / 2; G = C255(G * 7 / 5); B = B * 3 / 5; }
                else { R = R / 4; G = G / 4; B = B / 4; }
                dp[yy * W + x] = Argb(R, G, B);
            }
    }

    public static Bitmap MakeGlitch(int[] sp, int W, int H, int seed, int level)
    {
        Random r = new Random(seed);
        double k = W / 1280.0, hk = H / 720.0;
        int[] dp = (int[])sp.Clone();
        int nb = level == 1 ? 3 + r.Next(3) : 9 + r.Next(6);
        for (int i = 0; i < nb; i++)
        {
            int h = (int)((6 + r.Next(level == 1 ? 34 : 70)) * hk);
            int y0 = r.Next(Math.Max(1, H - h));
            int dx = (int)((r.NextDouble() - 0.5) * (level == 1 ? 90 : 420) * k);
            int split = (int)((level == 1 ? 2 : 4 + r.Next(8)) * k);
            Band(dp, sp, W, y0, h, dx, split);
        }
        if (level == 1)
        {
            int n = 3 + r.Next(3);
            for (int i = 0; i < n; i++)
            {
                Rectangle rc = new Rectangle(r.Next(W), r.Next(H), (int)((24 + r.Next(120)) * k), (int)((10 + r.Next(50)) * hk));
                int m = r.Next(3);
                if (m == 0) Mosaic(dp, W, H, rc, (int)Math.Max(4, (6 + r.Next(10)) * k));
                else if (m == 1) Noise(dp, W, H, rc, (int)Math.Max(1, 2 * k), r);
                else CopyBlock(dp, sp, W, H, rc, r.Next(W), r.Next(H), r.Next(1, 4));
            }
            int nl = 2 + r.Next(3);
            for (int i = 0; i < nl; i++) VLine(dp, W, H, r.Next(W), r.Next(H), (int)((30 + r.Next(160)) * hk), (int)Math.Max(1, 2 * k), r);
        }
        else
        {
            int a = 3 + r.Next(3);
            for (int i = 0; i < a; i++) Mosaic(dp, W, H, new Rectangle(r.Next(W), r.Next(H), (int)((200 + r.Next(500)) * k), (int)((80 + r.Next(220)) * hk)), (int)((10 + r.Next(24)) * k));
            int b = 6 + r.Next(6);
            for (int i = 0; i < b; i++) Noise(dp, W, H, new Rectangle(r.Next(W), r.Next(H), (int)((40 + r.Next(240)) * k), (int)((12 + r.Next(80)) * hk)), (int)Math.Max(1, (2 + r.Next(3)) * k), r);
            int c = 6 + r.Next(6);
            for (int i = 0; i < c; i++) CopyBlock(dp, sp, W, H, new Rectangle(r.Next(W), r.Next(H), (int)((60 + r.Next(300)) * k), (int)((20 + r.Next(100)) * hk)), r.Next(W), r.Next(H), r.Next(0, 4));
            for (int i = 0; i < 2; i++)
            {
                int y0 = r.Next(Math.Max(1, H - 120)); int rows = (int)((30 + r.Next(90)) * hk);
                for (int yy = y0 + 1; yy < Math.Min(H, y0 + rows); yy++) Array.Copy(dp, y0 * W, dp, yy * W, W);
            }
            for (int i = 0; i < 3; i++) Tint(dp, W, H, r.Next(Math.Max(1, H - 60)), (int)((30 + r.Next(90)) * hk), r.Next(3));
            for (int i = 0; i < 3; i++)
            {
                int x0 = r.Next(Math.Max(1, W - 60)), y0 = r.Next(Math.Max(1, H - 200)), w = (int)((40 + r.Next(220)) * k), h = (int)((60 + r.Next(300)) * hk);
                for (int yy = y0; yy < Math.Min(H, y0 + h); yy++) { int col = dp[yy * W + x0]; for (int xx = x0; xx < Math.Min(W, x0 + w); xx++) dp[yy * W + xx] = col; }
            }
        }
        return FromInts(dp, W, H);
    }
}
